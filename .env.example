# Same Neon database as CLIP. Prefer a role with SELECT-only grants.
DATABASE_URL=postgresql://reader:password@your-endpoint-pooler.neon.tech/neondb?sslmode=require
S3_BUCKET=your-game-film-bucket
AWS_REGION=us-east-2
# Use the cloud runtime's IAM role; local boto3 can use your AWS profile.
# All cloud replicas must share this Redis URL. rediss:// enables TLS.
REDIS_URL=
EYE_TEST_BROWSE_PER_MINUTE=120
EYE_TEST_PLAYBACK_PER_MINUTE=10
EYE_TEST_GLOBAL_PLAYBACK_PER_MINUTE=30
# Set only to the known number of trusted proxies; prevent direct origin access.
EYE_TEST_TRUSTED_PROXY_HOPS=0
# Comma-separated UI origins allowed to call this API. No trailing slash.
# Example: https://eye.example.com
EYE_TEST_ALLOWED_ORIGINS=
EYE_TEST_PORT=5009
PORT=8080
WEB_CONCURRENCY=2
